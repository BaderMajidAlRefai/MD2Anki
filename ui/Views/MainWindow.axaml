<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ui.ViewModels"
        xmlns:views="using:ui.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560"
        d:DesignHeight="720"
        x:Class="ui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Obsidian2Anki"
        Width="540"
        Height="640"
        MinWidth="480"
        MinHeight="560"
        Background="#151618"
        FontFamily="Inter">

    <Window.Resources>
        <ControlTheme x:Key="SelectionToggleTheme" TargetType="ToggleButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Viewbox Width="10"
                                 Height="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Path Data="M 1,5 L 4,8 L 10,1"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="DisclosureToggleTheme" TargetType="ToggleButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MaxHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#17181A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MaxHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D3D5D9" />
            <Setter Property="BorderBrush" Value="#3A3C40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#202124" />
            <Setter Property="BorderBrush" Value="#505257" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MaxWidth" Value="40" />
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B8BBC1" />
            <Setter Property="BorderBrush" Value="#35373B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="#242528" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.connectionRetry">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A7A9AE" />
            <Setter Property="BorderBrush" Value="#484A4F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style Selector="Button.connectionRetry:pointerover">
            <Setter Property="Background" Value="#25272A" />
            <Setter Property="Foreground" Value="#E4E5E7" />
        </Style>

        <Style Selector="ToggleButton.selection">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MaxWidth" Value="20" />
            <Setter Property="MaxHeight" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Theme" Value="{StaticResource SelectionToggleTheme}" />
            <Setter Property="Background" Value="#24262A" />
            <Setter Property="BorderBrush" Value="#55585F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="ToggleButton.selection:pointerover">
            <Setter Property="Background" Value="#2B2D31" />
            <Setter Property="BorderBrush" Value="#74777E" />
        </Style>

        <Style Selector="ToggleButton.selection:checked">
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#17181A" />
        </Style>

        <Style Selector="ToggleButton.selection:checked:pointerover">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
        </Style>

        <Style Selector="ToggleButton.disclosure">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MaxWidth" Value="30" />
            <Setter Property="MaxHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Theme" Value="{StaticResource DisclosureToggleTheme}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8F9298" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Content" Value="▸" />
        </Style>

        <Style Selector="ToggleButton.disclosure:pointerover">
            <Setter Property="Background" Value="#2B2D31" />
            <Setter Property="Foreground" Value="#E0E1E3" />
        </Style>

        <Style Selector="ToggleButton.disclosure:checked">
            <Setter Property="Content" Value="▾" />
        </Style>
    </Window.Styles>

    <Grid>
    <Grid x:Name="MainPage" RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="24,18"
                Background="#191A1D"
                BorderBrush="#303237"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <Image Source="/Assets/Obsidian2Anki_logo.png"
                       Width="96"
                       Height="38"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Classes="icon"
                        Content="⚙"
                        IsEnabled="{Binding IsBackendReady}"
                        ToolTip.Tip="Settings"
                        Click="OpenSettings_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,30,32,26"
                        MaxWidth="640"
                        HorizontalAlignment="Stretch"
                        Spacing="22">
                <Border Padding="18"
                        Background="#1B1C1F"
                        BorderBrush="#34363A"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Grid Width="8"
                                  Height="8"
                                  VerticalAlignment="Center">
                                <Border Background="#676A70"
                                        CornerRadius="4"
                                        IsVisible="{Binding IsConnectionStatusNeutral}" />
                                <Border Background="#7FA68A"
                                        CornerRadius="4"
                                        IsVisible="{Binding AreConnectionsReady}" />
                                <Border Background="#B59A68"
                                        CornerRadius="4"
                                        IsVisible="{Binding DoConnectionsNeedAttention}" />
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       Text="Connections"
                                       Foreground="#E4E5E7"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding BackendStatusLabel}"
                                       Foreground="#9A9DA3"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="#303236" />

                        <StackPanel Spacing="13">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Obsidian vault"
                                               Foreground="#A7A9AE"
                                               FontSize="13" />
                                    <TextBlock Text="Choose a vault folder in Settings."
                                               IsVisible="{Binding IsObsidianRootMissing}"
                                               Foreground="#B98A78"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Column="1"
                                      Margin="18,0,0,0"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NeutralConnectionStatusLabel}"
                                               IsVisible="{Binding IsConnectionStatusNeutral}"
                                               Foreground="#85878C"
                                               FontSize="12" />
                                    <TextBlock Text="Selected"
                                               IsVisible="{Binding HasObsidianRoot}"
                                               Foreground="#8FAE97"
                                               FontSize="12" />
                                    <TextBlock Text="Not selected"
                                               IsVisible="{Binding IsObsidianRootMissing}"
                                               Foreground="#C18572"
                                               FontSize="12" />
                                </Grid>
                            </Grid>

                            <Border Height="1" Background="#292B2F" />

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="AnkiConnect"
                                               Foreground="#A7A9AE"
                                               FontSize="13" />
                                    <TextBlock Text="Anki may be closed, or AnkiConnect may not be installed."
                                               IsVisible="{Binding IsAnkiDisconnected}"
                                               Foreground="#B98A78"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                    <Button Classes="connectionRetry"
                                            Content="Check again"
                                            Command="{Binding CheckConnectionsCommand}"
                                            IsVisible="{Binding IsAnkiDisconnected}" />
                                </StackPanel>

                                <Grid Grid.Column="1"
                                      Margin="18,0,0,0"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NeutralConnectionStatusLabel}"
                                               IsVisible="{Binding IsConnectionStatusNeutral}"
                                               Foreground="#85878C"
                                               FontSize="12" />
                                    <TextBlock Text="Connected"
                                               IsVisible="{Binding IsAnkiConnected}"
                                               Foreground="#8FAE97"
                                               FontSize="12" />
                                    <TextBlock Text="Not connected"
                                               IsVisible="{Binding IsAnkiDisconnected}"
                                               Foreground="#C18572"
                                               FontSize="12" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10">
                    <Button Classes="primary"
                            Content="Review and sync"
                            Command="{Binding LoadPlanCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Classes="secondary"
                            Content="Quick sync"
                            Command="{Binding QuickSyncCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <TextBlock Text="Quick sync applies changes without showing a preview."
                               Foreground="#85878C"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           IsVisible="{Binding HasStatusMessage}"
                           Foreground="#A7A9AE"
                           FontSize="12"
                           TextWrapping="Wrap" />

                <Border IsVisible="{Binding IsReviewVisible}"
                        Background="#191A1D"
                        BorderBrush="#34363A"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Margin="18,16">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Review changes"
                                           Foreground="#F0F1F2"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Uncheck anything you don't want to add."
                                           Foreground="#85878C"
                                           FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Decks.Count, StringFormat='{}{0} decks'}"
                                       Foreground="#9A9DA3"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="#303236" />

                        <ItemsControl Margin="12,12,12,2"
                                      ItemsSource="{Binding Decks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeckReviewViewModel">
                                    <Border Margin="0,0,0,10"
                                            Background="#202124"
                                            BorderBrush="#383A3F"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            ClipToBounds="True">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  Margin="14,11">
                                                <ToggleButton Classes="selection"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              ToolTip.Tip="Include this deck and all of its cards" />
                                                <StackPanel Grid.Column="1"
                                                            Margin="11,0,0,0"
                                                            Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#ECEDEF"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Foreground="#85878C"
                                                               FontSize="10" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="2"
                                                              Classes="disclosure"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              ToolTip.Tip="Expand or collapse deck" />
                                            </Grid>

                                            <Border Padding="12"
                                                    IsVisible="{Binding IsExpanded}"
                                                    Background="#18191B"
                                                    BorderBrush="#34363A"
                                                    BorderThickness="0,1,0,0">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Cards}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CardReviewViewModel">
                                                                <Border Margin="0,0,0,8"
                                                                        Padding="12"
                                                                        Background="#1E1F22"
                                                                        BorderBrush="#303237"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4">
                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                        <ToggleButton Classes="selection"
                                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                      Margin="0,2,11,0"
                                                                                      VerticalAlignment="Top"
                                                                                      ToolTip.Tip="Include this card" />
                                                                        <StackPanel Grid.Column="1" Spacing="7">
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Text="FRONT"
                                                                                           Foreground="#6F7278"
                                                                                           FontSize="9"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBlock Text="{Binding Front}"
                                                                                           Foreground="#E2E3E5"
                                                                                           FontSize="12"
                                                                                           TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                            <Border Height="1" Background="#2B2D31" />
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Text="BACK"
                                                                                           Foreground="#6F7278"
                                                                                           FontSize="9"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBlock Text="{Binding Back}"
                                                                                           Foreground="#B9BBC0"
                                                                                           FontSize="12"
                                                                                           TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock IsVisible="{Binding HasNoCards}"
                                                               Margin="2,2,2,4"
                                                               Text="This deck has no new cards."
                                                               Foreground="#74777D"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Padding="12,2,12,12">
                            <Button Classes="primary"
                                    Content="Execute selected changes"
                                    Command="{Binding ExecutePlanCommand}"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,13"
                Background="#191A1D"
                BorderBrush="#303237"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="1"
                           Text="v0.1"
                           Foreground="#73767C"
                           FontSize="12" />
            </Grid>
        </Border>
    </Grid>

    <views:SettingsView x:Name="SettingsPage"
                        IsVisible="False" />
    </Grid>
</Window>
